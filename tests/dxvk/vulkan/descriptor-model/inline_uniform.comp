#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer OutBuf {
    uint data[];
} out_buf;

layout(set = 0, binding = 1) uniform U {
    uvec4 d[4];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;
    out_buf.data[i] = d[(i % 16u) / 4u][i % 4u] + i;
}
