#version 460
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer OutBuf {
    uint data[];
} out_buf;

layout(set = 0, binding = 1, std430) readonly buffer InBuf {
    uint v[];
} ins[4];

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint a = ins[0].v[i];
    uint b = ins[2].v[i];
    out_buf.data[i] = a + (b << 16u);
}
