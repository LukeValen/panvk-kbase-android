#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Output {
    uint out_data[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 64u)
        return;
    int16_t a = int16_t(int(i) * 1237 - 30000);
    int16_t b = int16_t(int(i) * 911 + 17);
    int16_t r1 = a * b;
    int16_t r2 = a - b;
    int16_t r3 = a >> 3;
    uint16_t r4 = uint16_t(a) * uint16_t(0x9E37u);
    out_data[i * 4u + 0u] = uint(int(r1));
    out_data[i * 4u + 1u] = uint(int(r2));
    out_data[i * 4u + 2u] = uint(int(r3));
    out_data[i * 4u + 3u] = uint(r4);
}
