    }
 
    result = vk_anb_semaphore_init_once(queue, device);
-   mesa_logi("[ANB-SYNC] semaphore init result=%d", result);
    if (result != VK_SUCCESS)
       return result;
 
@@ -637,10 +629,8 @@ vk_common_QueueSignalReleaseImageANDROID(VkQueue _queue,
       .stageMask = VK_PIPELINE_STAGE_2_TRANSFER_BIT,
    };
    if (device->copy_sync_payloads != NULL) {
-      mesa_logi("[ANB-SYNC] release path=copy_sync_payloads");
       result = vk_device_copy_semaphore_payloads(
          device, waitSemaphoreCount, wait_infos, 1, &signal_info, 0, NULL);
