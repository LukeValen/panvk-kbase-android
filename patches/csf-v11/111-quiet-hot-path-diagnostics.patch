       .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
       .pNext = &export_info,
    };
-   VkResult result = device->dispatch_table.CreateSemaphore(
+   return device->dispatch_table.CreateSemaphore(
       vk_device_to_handle(device), &create_info, NULL, &queue->anb_semaphore);
-   mesa_logi("[ANB-SYNC] CreateSemaphore(export SYNC_FD) result=%d semaphore=%p",
-             result, (void *)(uintptr_t)queue->anb_semaphore);
-   return result;
 }
 
