          .pSignalSemaphoreInfos = &signal_info,
       };
-      mesa_logi("[ANB-SYNC] release path=QueueSubmit2 waits=%u",
-                waitSemaphoreCount);
       result = device->dispatch_table.QueueSubmit2(_queue, 1, &submit_info,
                                                    VK_NULL_HANDLE);
-      mesa_logi("[ANB-SYNC] QueueSubmit2 result=%d", result);
    }
    STACK_ARRAY_FINISH(wait_infos);
    if (result != VK_SUCCESS)
@@ -694,8 +681,6 @@ vk_common_QueueSignalReleaseImageANDROID(VkQueue _queue,
    *pNativeFenceFd = -1;
    result = device->dispatch_table.GetSemaphoreFdKHR(
